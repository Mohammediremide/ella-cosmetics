# Copy to .env for local development. NEVER commit .env. On a host, set these in its environment settings instead.

# --- Django core ---------------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string      # required (app refuses to start in production without it)
DJANGO_DEBUG=true                                        # true ONLY on your own computer; must be false in production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1                 # production: your API host, e.g. ella-api.onrender.com
LOG_LEVEL=INFO

# --- Database ------------------------------------------------------------------------------------
# Empty => local SQLite file (development only; production REFUSES to start without it).
# Production: your Neon DIRECT (non-pooled) connection string, set in Render's environment settings.
DATABASE_URL=

# --- Frontend / cookies / CSRF -------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173                    # production (required): https://your-store-url, no trailing slash
EXTRA_FRONTEND_ORIGINS=                                  # optional, comma-separated (e.g. a Vercel preview domain)
COOKIE_SAMESITE=Lax                                      # keep Lax when the storefront proxies /api (recommended); None only for direct cross-site calls
SECURE_SSL_REDIRECT=true                                 # production default; set false only if your host terminates HTTP itself

# --- Product images (Cloudinary) -----------------------------------------------------------------
# Empty => images saved on local disk (development only; production REFUSES to start without it).
# Production: cloudinary://API_KEY:API_SECRET@CLOUD_NAME from the Cloudinary dashboard. SECRET: backend only.
CLOUDINARY_URL=

# --- Email (password reset). Without EMAIL_HOST, production discards emails; dev prints them to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Ella Cosmetics <no-reply@yourdomain.com>

# --- Set automatically by Render (no action needed): RENDER_EXTERNAL_HOSTNAME
